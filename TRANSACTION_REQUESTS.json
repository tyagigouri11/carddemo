  "validation_tests": [
    {
      "request_id": "REQ_16",
      "name": "NEGATIVE AMOUNT - Should Fail (400)",
      "data": {
        "accountId": 1,
        "cardNumber": "4111111111111111",
        "amount": -50.00,
        "date": "2026-10-15",
        "postDate": "2026-10-15",
        "type": "PURCHASE",
        "status": "PENDING",
        "merchantId": "M999",
        "merchantName": "Invalid Test"
      },
      "expected_status": 400,
      "expected_error": "Amount must be positive"
    },
    {
      "request_id": "REQ_17",
      "name": "MISSING AMOUNT - Should Fail (400)",
      "data": {
        "accountId": 1,
        "cardNumber": "4111111111111111",
        "date": "2026-10-15",
        "postDate": "2026-10-15",
        "type": "PURCHASE",
        "status": "PENDING",
        "merchantId": "M999",
        "merchantName": "Invalid Test"
      },
      "expected_status": 400,
      "expected_error": "Amount is required"
    }
  ],
  
  "settlement_tests": [
    {
      "request_id": "REQ_18",
      "endpoint": "POST /api/transactions/settle",
      "name": "SETTLE VALID TRANSACTION",
      "data": {
        "transactionId": "USE_ID_FROM_REQ_6"
      },
      "expected_status": 200,
      "note": "After getting ID from REQ_6, use it here"
    },
    {
      "request_id": "REQ_19",
      "endpoint": "POST /api/transactions/settle",
      "name": "DOUBLE SETTLEMENT - Should Fail (422)",
      "data": {
        "transactionId": "USE_SAME_ID_FROM_REQ_18"
      },
      "expected_status": 422,
      "expected_error": "Transaction already settled"
    },
    {
      "request_id": "REQ_20",
      "endpoint": "POST /api/transactions/settle",
      "name": "SETTLE NON-EXISTENT - Should Fail (404)",
      "data": {
        "transactionId": "TXN_INVALID_99999"
      },
      "expected_status": 404,
      "expected_error": "Transaction not found"
    }
  ]
